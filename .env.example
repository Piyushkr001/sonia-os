# -----------------------------------------------------------------------------
# SONIA.OS Environment Configuration Example
# Copy this file to .env.local (or .env) and fill in real values.
# Never commit real secrets to version control.
# -----------------------------------------------------------------------------

# Public deployment URL (optional locally; recommended in production for canonical/OG URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL connection string (pooled or direct with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini API (server-side only)
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash
AI_DAILY_LIMIT=100

# Connection Portal & SMTP Notifications (server-side only)
CONTACT_DAILY_LIMIT=100
CONTACT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_smtp_username@example.com
CONTACT_RECEIVER_EMAIL=authorized_recipient@example.com

# Private Intelligence Insights Dashboard (min 32 characters)
ANALYTICS_ADMIN_TOKEN=replace_with_a_random_32_plus_character_secret_token

# Analytics Daily Ingestion Quotas
ANALYTICS_DAILY_EVENT_LIMIT=10000
ANALYTICS_DAILY_SESSION_LIMIT=1000

# Distributed Rate Limiting (Neon-backed, server-side only)
RATE_LIMIT_SALT=replace_with_a_random_salt_for_client_hashing
RATE_LIMIT_CHAT_MAX=15
RATE_LIMIT_CHAT_WINDOW_SEC=300
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_SEC=900
RATE_LIMIT_ANALYTICS_EVENTS_MAX=60
RATE_LIMIT_ANALYTICS_EVENTS_WINDOW_SEC=60
RATE_LIMIT_ANALYTICS_SUMMARY_MAX=20
RATE_LIMIT_ANALYTICS_SUMMARY_WINDOW_SEC=60
